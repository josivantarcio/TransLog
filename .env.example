# ============================================================
# transLog Backend - Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# ============================================================

# --- Aplicação ---
APP_NAME="transLog"
APP_ENV="development"          # development | staging | production
DEBUG=true
SECRET_KEY="troque-por-uma-chave-secreta-aleatoria-de-64-chars"

# --- JWT ---
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Banco de Dados (PostgreSQL) ---
DATABASE_URL="postgresql+asyncpg://translog:translog@localhost:5432/translog"

# --- Redis ---
REDIS_URL="redis://localhost:6379/0"

# --- CORS ---
# Array JSON de origens permitidas
ALLOWED_ORIGINS='["http://localhost:3000","http://localhost:5173"]'

# --- Gateway de Pagamento (Asaas) ---
ASAAS_API_KEY="$sua_chave_asaas"
ASAAS_API_URL="https://sandbox.asaas.com/api/v3"  # sandbox
# ASAAS_API_URL="https://www.asaas.com/api/v3"    # produção
ASAAS_WEBHOOK_SECRET="seu_webhook_secret_asaas"

# --- Email (opcional) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAILS_FROM_EMAIL="noreply@translog.com.br"
EMAILS_FROM_NAME="transLog"

# --- QR Code / OTP ---
OTP_ISSUER_NAME="transLog"
QR_CODE_TTL_SECONDS=300        # 5 minutos

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60
